
from trading import TradingEngine

def test_dexon():

    bot = TradingEngine(100.00)

    print("🚀 DEXON SYSTEM TEST")

    print("Starting balance:", bot.get_balance())

    result = bot.buy("TEST_TOKEN", 10.00)
    print("BUY:", result)

    print("Balance after buy:", bot.get_balance())

    result = bot.sell("TEST_TOKEN")
    print("SELL:", result)

    print("Final balance:", bot.get_balance())

    print("Auto Trading:", bot.toggle_auto())

    print("✅ DEXON TEST COMPLETED")

if __name__ == "__main__":
    test_dexon()
